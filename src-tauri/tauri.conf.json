{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WinOpt",
  "version": "0.1.0",
  "identifier": "com.lacuca.winopt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WinOpt — Optimizador de Windows 11",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Luis Solano",
    "shortDescription": "Optimizador seguro y reversible de Windows 11",
    "longDescription": "WinOpt optimiza Windows 11 en 3 modos (Conservador, Equilibrado y Agresivo) cubriendo limpieza, rendimiento, privacidad y red. Cada cambio es reversible individualmente o en bloque desde el historial, con creación opcional de un punto de restauración antes de aplicar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SpanishInternational", "English"]
      }
    }
  }
}